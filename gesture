<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>かざしてジェスチャー認証</title>
  
  <!-- MediaPipe Hands と 描画ライブラリの読み込み -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #0f172a;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      text-align: center;
    }
    .card {
      background: #1e293b;
      padding: 2rem;
      border-radius: 1rem;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      width: 90%;
      max-width: 440px;
    }
    h2 { margin-bottom: 0.5rem; font-size: 1.4rem; }
    p { font-size: 0.9rem; color: #94a3b8; }

    /* カメラ・描画キャンバスの重ね合わせ */
    .canvas-container {
      position: relative;
      width: 100%;
      max-width: 360px;
      height: 270px;
      margin: 1.2rem auto;
      border-radius: 0.8rem;
      overflow: hidden;
      background: #000;
    }
    video, canvas {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    /* 鏡合わせ表示（自然な操作感のため） */
    .mirror { transform: scaleX(-1); }

    .target-pose {
      font-size: 1.2rem;
      font-weight: bold;
      color: #38bdf8;
      background: #0f172a;
      padding: 0.6rem;
      border-radius: 0.5rem;
      margin-top: 0.8rem;
    }

    .btn {
      background: #3b82f6;
      color: white;
      border: none;
      padding: 0.8rem 1.5rem;
      font-size: 1rem;
      font-weight: bold;
      border-radius: 0.5rem;
      cursor: pointer;
      margin-top: 1rem;
      width: 100%;
    }

    /* チェックマークアニメーション */
    .checkmark-svg {
      width: 80px; height: 80px;
      margin: 1.5rem auto;
      stroke: #22c55e; stroke-width: 3; stroke-miterlimit: 10;
      animation: scale .3s ease-in-out forwards;
    }
    .checkmark-circle { stroke-dasharray: 166; stroke-dashoffset: 166; animation: stroke 0.6s forwards; }
    .checkmark-check { stroke-dasharray: 48; stroke-dashoffset: 48; animation: stroke 0.3s 0.6s forwards; }
    @keyframes stroke { 100% { stroke-dashoffset: 0; } }
    @keyframes scale { 0%, 100% { transform: none; } 50% { transform: scale3d(1.1, 1.1, 1); } }
  </style>
</head>
<body>

  <div class="card">
    <!-- ステップ 1: カメラ起動ボタン ＆ 準備 -->
    <div id="step-init">
      <h2>ジェスチャーかざして認証</h2>
      <p>指定されたポーズをカメラにかざしてログインします</p>
      
      <div class="target-pose">指定ポーズ: ✌️ ピース</div>
      <button class="btn" onclick="startCamera()">📷 カメラを起動して認証開始</button>
    </div>

    <!-- ステップ 2: カメラ認識中 -->
    <div id="step-active" style="display: none;">
      <h2>手をカメラにかざしてください</h2>
      <p id="pose-instruction">「✌️ ピース」を作ってください</p>

      <div class="canvas-container">
        <video id="input-video" class="mirror" playsinline></video>
        <canvas id="output-canvas" class="mirror"></canvas>
      </div>

      <p id="detect-status" style="color: #e2e8f0; font-weight: bold;">検出中...</p>
    </div>

    <!-- ステップ 3: 認証成功 -->
    <div id="step-success" style="display: none;">
      <svg class="checkmark-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
        <circle class="checkmark-circle" cx="26" cy="26" r="23" fill="none"/>
        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
      </svg>
      <h2>認証成功！</h2>
      <p>サインが一致しました。ログイン完了です。</p>
    </div>
  </div>

  <script>
    const videoElement = document.getElementById('input-video');
    const canvasElement = document.getElementById('output-canvas');
    const canvasCtx = canvasElement.getContext('2d');
    
    let camera = null;
    let isAuthenticated = false;

    // MediaPipe Hands の初期化
    const hands = new Hands({
      locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
    });

    hands.setOptions({
      maxNumHands: 1,           // 1つの手だけを認識
      modelComplexity: 1,
      minDetectionConfidence: 0.7,
      minTrackingConfidence: 0.7
    });

    hands.onResults(onResults);

    // カメラ起動処理
    function startCamera() {
      document.getElementById('step-init').style.display = 'none';
      document.getElementById('step-active').style.display = 'block';

      camera = new Camera(videoElement, {
        onFrame: async () => {
          if (!isAuthenticated) {
            await hands.send({ image: videoElement });
          }
        },
        width: 640,
        height: 480
      });
      camera.start();
    }

    // 手の関節座標データ（21個のキーポイント）の解析
    function onResults(results) {
      // 描画領域の初期化
      canvasElement.width = videoElement.videoWidth;
      canvasElement.height = videoElement.videoHeight;

      canvasCtx.save();
      canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

      if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
        const landmarks = results.multiHandLandmarks[0];

        // 骨格線の描画
        drawConnectors(canvasCtx, landmarks, HAND_CONNECTIONS, { color: '#00FF00', lineWidth: 3 });
        drawLandmarks(canvasCtx, landmarks, { color: '#FF0000', lineWidth: 1, radius: 4 });

        // ジェスチャー判定
        const isPeace = checkPeaceSign(landmarks);

        if (isPeace) {
          document.getElementById('detect-status').innerText = "✔ 「ピース」を検出！";
          document.getElementById('detect-status').style.color = "#22c55e";

          if (!isAuthenticated) {
            isAuthenticated = true;
            setTimeout(() => {
              document.getElementById('step-active').style.display = 'none';
              document.getElementById('step-success').style.display = 'block';
              if (camera) camera.stop();
            }, 800);
          }
        } else {
          document.getElementById('detect-status').innerText = "手をかざして「ピース」を作ってください...";
          document.getElementById('detect-status').style.color = "#e2e8f0";
        }
      } else {
        document.getElementById('detect-status').innerText = "手をカメラに映してください";
        document.getElementById('detect-status').style.color = "#94a3b8";
      }
      canvasCtx.restore();
    }

    // 「ピースサイン」かどうかの判定ロジック
    function checkPeaceSign(lm) {
      // 指先のY座標と、関節（第2関節など）のY座標を比較して上がっているか判定
      // 画面上はY座標が小さいほど「上」になる

      const indexExtended  = lm[8].y < lm[6].y;   // 人差し指が伸びている
      const middleExtended = lm[12].y < lm[10].y; // 中指が伸びている
      const ringFolded     = lm[16].y > lm[14].y; // 薬指が曲がっている
      const pinkyFolded    = lm[20].y > lm[18].y; // 小指が曲がっている

      return indexExtended && middleExtended && ringFolded && pinkyFolded;
    }
  </script>
</body>
</html>
